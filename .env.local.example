# Local development (npm run dev:up writes/uses this). Copy to .env.local.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/organiser
NEON_LOCAL=1
# Any long random string locally; in prod: openssl rand -hex 32
AUTH_SECRET=dev-secret-change-me-0123456789abcdef
# Public base URL, used for invite links and QR labels
APP_URL=http://localhost:3000
# Vercel Blob token (photos). Pull with `vercel env pull` or leave empty until Task 8.
BLOB_READ_WRITE_TOKEN=
